# Copy to .env (which is gitignored) and fill in locally. Never commit .env.
# Broker: paper (built-in simulator) | manual (order tickets you place at Fidelity yourself) | alpaca
ROVIO_BROKER=paper
ROVIO_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,BTC-USD,ETH-USD,EURUSD=X,FXAIX
ROVIO_STARTING_CASH=100000

# Risk limits
ROVIO_RISK_PER_TRADE_PCT=1.0
ROVIO_MAX_POSITION_PCT=20
ROVIO_MAX_OPEN_POSITIONS=10
ROVIO_MAX_DAILY_LOSS_PCT=3.0

# Alpaca (only if ROVIO_BROKER=alpaca). Leave blank here; set values in your local .env only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Paper trading endpoint is used unless this is exactly "true".
ALPACA_LIVE=false
