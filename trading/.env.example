# Copy to .env (gitignored) and fill in ON YOUR MACHINE ONLY. Never commit .env, never paste these
# values into a chat, a config file, or the dashboard. Leave a line blank to keep that integration off.

# Alpaca PAPER trading (US stocks/ETFs and BTC/USD) -> paper-api.alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# OANDA v20 PRACTICE (spot forex) -> api-fxpractice.oanda.com. The account must be in USD.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# Optional: a webhook URL (Slack/Teams/Discord style, receives {"text": "..."}) for alerts.
ROVIO_ALERT_WEBHOOK=

# LIVE credentials use DIFFERENT variable names on purpose, so nothing in config.toml can turn a
# paper session into a live one. Leave blank unless you have read "Going live" in the README.
ALPACA_LIVE_API_KEY_ID=
ALPACA_LIVE_API_SECRET_KEY=
OANDA_LIVE_API_TOKEN=
OANDA_LIVE_ACCOUNT_ID=
